# Gallery API Environment Variables Template
# 复制此文件为 .env.local 并填写实际值

# ====================================
# 数据库配置
# ====================================
DB_URL=jdbc:mysql://localhost:13306/vie_gallery?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=vie
DB_PASSWORD=your-db-password

# ====================================
# Redis 配置
# ====================================
REDIS_URL=redis://localhost:6379

# ====================================
# 对象存储配置
# ====================================
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=your-minio-access-key
STORAGE_SECRET_KEY=your-minio-secret-key
STORAGE_BUCKET=vie-gallery

# ====================================
# 安全配置 (必须配置)
# ====================================
# 使用 scripts/generate-security-keys.sh 生成这些密钥

# AES-256 加密密钥 (32字节 base64编码)
GALLERY_SECURITY_ENCRYPTION_SECRET=your-32-byte-base64-encoded-secret

# 加密盐值 (16字节 hex编码)
GALLERY_SECURITY_ENCRYPTION_SALT=your-16-byte-hex-salt

# JWT 签名密钥 (32字节 base64编码)
GALLERY_SECURITY_JWT_SECRET=your-jwt-secret-base64

# ====================================
# 照片 URL 安全配置
# ====================================
# 照片URL默认有效期 (秒)
PHOTO_URL_EXPIRY=3600

# 照片URL最大有效期 (秒)
PHOTO_URL_MAX_EXPIRY=86400

# ====================================
# Session 配置
# ====================================
SESSION_TTL=7d
SESSION_COOKIE_SECURE=false

# ====================================
# 配额限制
# ====================================
QUOTA_MAX_BYTES=5368709120
QUOTA_MAX_PHOTOS=10000
MAX_FILE_SIZE_BYTES=104857600
MAX_IMAGE_PIXELS=40000000
MAX_BATCH_FILES=50

# ====================================
# 速率限制
# ====================================
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_WINDOW=PT15M
UNLOCK_RATE_LIMIT_MAX_FAILURES=5
UNLOCK_RATE_LIMIT_WINDOW=PT15M

# ====================================
# SSL 配置 (生产环境必须启用)
# ====================================
# SSL_KEYSTORE_PATH=classpath:keystore.p12
# SSL_KEYSTORE_PASSWORD=your-keystore-password
# SSL_KEY_ALIAS=gallery-api
