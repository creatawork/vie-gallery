FROM maven:3.9-eclipse-temurin-17-alpine as builder
WORKDIR /app

# Copy parent POM and API module
COPY pom.xml .
COPY apps/gallery-api/ ./apps/gallery-api/

# Build the project
RUN mvn -f apps/gallery-api/pom.xml clean package -DskipTests

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

# Copy the JAR from the boot module
COPY --from=builder /app/apps/gallery-api/gallery-api-boot/target/*.jar app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
