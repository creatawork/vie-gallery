# Stage 1: Build Admin & Viewer Frontends
FROM node:20-alpine AS builder
WORKDIR /app

COPY package*.json ./
COPY packages/ ./packages/
COPY apps/gallery-admin/ ./apps/gallery-admin/
COPY apps/gallery-viewer/ ./apps/gallery-viewer/

RUN npm ci
RUN npm run build

# Stage 2: Nginx Static Server
FROM nginx:1.27-alpine
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/gallery-admin/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
