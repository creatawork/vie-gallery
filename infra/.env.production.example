# VIE Gallery 生产环境配置模板
#
# 使用方式：在服务器上创建 ~/vie-gallery/infra/.env.production 并填入真实值。
# 该文件有两个用途（缺一不可）：
#   1. 部署命令通过 --env-file 加载，供 docker compose 变量插值；
#   2. compose 中 api 服务的 env_file 直接引用，把变量注入 API 容器。
#
# ⚠️ 安全密钥与阿里云 OSS 变量缺失或为空时，API 无法启动，表现为 502。
#    部署流程会在重启容器前预检这些变量，缺了会直接报错终止。

# ---------- Spring ----------
# 生产必须包含 aliyun-oss profile，媒体文件才会走阿里云 OSS
SPRING_PROFILES_ACTIVE=prod,aliyun-oss

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=vie_gallery_root_2026
MYSQL_PASSWORD=vie_password_2026

# ---------- MinIO（保留用于内部存储端口兜底配置与健康检查）----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ---------- 安全密钥（必需！生成方式：bash scripts/generate-security-keys.sh）----------
# GALLERY_SECURITY_ENCRYPTION_SECRET：AES-256 加密密钥，openssl rand -base64 32
# GALLERY_SECURITY_ENCRYPTION_SALT：加密盐值，openssl rand -hex 16
# GALLERY_SECURITY_JWT_SECRET：JWT 签名密钥，openssl rand -base64 32（解码后须 >= 32 字节）
GALLERY_SECURITY_ENCRYPTION_SECRET=
GALLERY_SECURITY_ENCRYPTION_SALT=
GALLERY_SECURITY_JWT_SECRET=

# ---------- 阿里云 OSS（必需！）----------
ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=vie-gallery

# ---------- 邮件（默认关闭）----------
# 默认 GALLERY_MAIL_ENABLED 未设置（=关闭）：不发真实邮件，
# 密码重置请求仅在 API 日志中记录（不记录 token）。
# 启用真实邮件：设 GALLERY_MAIL_ENABLED=true 并填入下方真实 SMTP 配置。
#GALLERY_MAIL_ENABLED=true
#MAIL_HOST=smtp.example.com
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_FROM=noreply@vie-vibe.cn
#MAIL_SMTP_AUTH=true
#MAIL_SMTP_STARTTLS=true

# ---------- 可选：公开地址 ----------
#ADMIN_PUBLIC_BASE_URL=http://gallery.vie-vibe.cn/app
#GALLERY_PUBLIC_BASE_URL=http://gallery.vie-vibe.cn/g
#STORAGE_PUBLIC_ENDPOINT=http://gallery.vie-vibe.cn:9000
