{
  "name": "vie-gallery",
  "private": true,
  "workspaces": ["apps/gallery-admin", "apps/gallery-viewer", "packages/*"],
  "scripts": {
    "dev:admin": "npm --workspace apps/gallery-admin run dev",
    "dev:viewer": "npm --workspace apps/gallery-viewer run dev",
    "check:docs": "node scripts/check-markdown-links.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run check:docs && npm run typecheck && npm run build"
  }
}
